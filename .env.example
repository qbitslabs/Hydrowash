# SMTP Configuration for Nodemailer (Brochure Email Service)
# For Gmail: host=smtp.gmail.com, port=465, secure=true (use an App Password: https://myaccount.google.com/apppasswords)
# For Titan/Custom: host=smtp.titan.email or your provider's SMTP host
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@hydrowash.in
SMTP_PASS=your_smtp_password_here

# Business notification email - where customer lead alerts are sent
BUSINESS_EMAIL=info@hydrowash.in

# Google Sheets Webhook (Apps Script Web App deploy URL) to log leads
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Instagram Graph API Access Token (Optional: fallback mock data is used if empty)
# INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
